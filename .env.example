# MongoDB connection
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE_NAME=rag_pubmed_chatbot
MONGO_COLLECTION_NAME=pubmed_chunks
MONGO_MEMORY_COLLECTION_NAME=chat_memory

# Optional: choose one exact CSV file from data/
# PUBMED_CSV_FILE=PubMed Multi Label Text Classification Dataset Processed.csv

# Embedding model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DEVICE=cpu

# Chunking
CHUNK_SIZE_WORDS=180
CHUNK_OVERLAP_WORDS=40

# Ingestion
MONGO_WRITE_BATCH_SIZE=64

# Answer confidence threshold
MIN_RETRIEVAL_SCORE=0.15

